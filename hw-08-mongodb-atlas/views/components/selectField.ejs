<label>
  <span><%= label %></span>
  <select name="<%= name %>" <%= required ? "required" : "" %>>
    <option value="" disabled <%= !selectedId ? "selected" : "" %> hidden>
      <%= placeholder %>
    </option>

    <% if (!required) { %>
    <option value=""><%= placeholderEmpty %></option>
    <% } %>

    <% options.forEach(option => { %>
    <option value="<%= option._id %>" <%= selectedId === option._id.toString() ? "selected" : "" %>>
      <%= option[optionLabel] %>
    </option>
    <% }) %>
  </select>
  <small class="car-form__error"><%= error %></small>
</label>