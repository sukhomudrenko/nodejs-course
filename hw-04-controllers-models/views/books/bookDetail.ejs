<!DOCTYPE html>
<html>

<head>
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <%- include('../components/favicons.ejs') %>
</head>

<body>
  <%-include('../components/header.ejs', {activePage:'books'}) %>
  <main>
    <h1><span class="small-text">Назва книги:</span> <%= book.title %></h1>
    <h2><span class="small-text">Автор книги:</span> <%= book.author %></h2>
    <h3><span class="small-text">Рік випуску книги:</span> <%= book.year %> р.</h3>
    <a href="/books" class="btn btn-primary">
      Перейти до списку книг
    </a>
  </main>
  <%-include('../components/footer.ejs') %>
</body>

</html>